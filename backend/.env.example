# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajueasy?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ─── E-mail (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@ajueasy.com.br
SMTP_PASS=your-smtp-password
MAIL_FROM="Ajueasy <noreply@ajueasy.com.br>"
APP_URL=http://localhost:5173

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ajueasy.com.br
ADMIN_PASSWORD=Admin@2024!

# ─── Iugu (escrow de pagamentos) ─────────────────────────────────────────────
# Sem essas variáveis → modo sandbox (simulado, sem dinheiro real).
# Para produção, crie uma conta Iugu Marketplace (requer CNPJ):
#   https://app.iugu.com
#
# IUGU_API_KEY     → chave de API da conta principal (plataforma)
# IUGU_ACCOUNT_ID  → ID da conta principal no painel Iugu
# IUGU_SANDBOX     → 'false' para produção real (default: true/sandbox)
# PLATFORM_FEE_PCT → % de comissão da plataforma (default: 10)
IUGU_API_KEY=
IUGU_ACCOUNT_ID=
IUGU_SANDBOX=true
PLATFORM_FEE_PCT=10

# ─── DataJud (andamento processual) ──────────────────────────────────────────
# Chave pública padrão do CNJ (sem cadastro necessário, 120 req/min).
# Para chave dedicada (maior limite): https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendFbXNpTT

# ─── Anthropic / Claude (explicação por IA dos movimentos processuais) ────────
# Sem esta chave a API ainda funciona, mas sem as explicações em linguagem simples.
ANTHROPIC_API_KEY=sk-ant-...
