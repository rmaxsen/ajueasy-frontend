# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajueasy?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# ─── E-mail (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@ajueasy.com.br
SMTP_PASS=your-smtp-password
MAIL_FROM="Ajueasy <noreply@ajueasy.com.br>"
APP_URL=http://localhost:5173

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ajueasy.com.br
ADMIN_PASSWORD=Admin@2024!
