# ─── Backend API ──────────────────────────────────────────────────────────────
# URL base da API REST. Em produção, aponte para seu serviço no Render/Railway.
# Dev local:      http://localhost:3333
# Render:         https://ajueasy-api.onrender.com
# Railway:        https://<seu-servico>.up.railway.app
VITE_API_URL=http://localhost:3333

# ─── Ambiente ────────────────────────────────────────────────────────────────
VITE_APP_ENV=development

# ─── App URL (usada em links de e-mail, compartilhamento) ────────────────────
# Dev local: http://localhost:5173
# Produção:  https://ajueasy.vercel.app
VITE_APP_URL=http://localhost:5173

# ─── Pagamentos (Iugu — escrow) ──────────────────────────────────────────────
# Não há variáveis públicas do Iugu no frontend.
# As chaves ficam exclusivamente no backend (backend/.env).
# Consulte backend/.env.example para configurar IUGU_API_KEY e IUGU_ACCOUNT_ID.
